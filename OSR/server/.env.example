# OSR CMS backend — copy to .env and adjust.
# Admin login works even without JWT_SECRET (a temporary secret is generated),
# but sessions will not survive server restarts until you set it.

# 32+ characters. Required for persistent admin sessions.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional overrides
# DB_PATH=./db/osr.db
# ADMIN_EMAIL=admin@osr.bulsu.edu.ph
# ADMIN_PASSWORD=Admin123!
# PORT=4000
