# OSR CMS — standalone with Neon only
# Copy to OSR/server/.env for local dev, or set only DATABASE_URL in Netlify.

NODE_ENV=development
PORT=4000

# ── Only required env var in production (Netlify) ──
# Your Neon pooled connection string. Admin credentials live in Neon, not env.
# Example: postgresql://user:pass@ep-xxx-pooler.../neondb?sslmode=require
DATABASE_URL=

# ── Optional ──
# JWT_SECRET is now auto-generated and persisted in site_settings (jwt_secret)
# so sessions survive cold starts without env config. Set it only if you want
# to override the persisted secret (32+ random chars recommended).
JWT_SECRET=

# ── Deprecated / ignored in standalone mode ──
# ADMIN_EMAIL and ADMIN_PASSWORD are not read from env and never have been in
# this mode. The site ships no default account: the first administrator is the
# one the setup form on /admin creates, and its hash lives in the `admins`
# table. These keys remain only so an old .env does not break, and are ignored.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local data paths (used only when DATABASE_URL is empty → SQLite)
DB_PATH=./db/local-osr.db
UPLOAD_DIR=./uploads

# Comma-separated browser origins allowed for cross-origin credentialed API calls
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
