# OSR CMS — local development example. Copy to OSR/server/.env and fill in the values.
NODE_ENV=development
PORT=4000

# Production: set your Neon pooled URL privately in Netlify Functions settings.
# Local: leave empty for SQLite, or use a separate test Neon database.
DATABASE_URL=

# Optional for local use; if omitted, the server creates an ephemeral dev-only secret.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. If not set, the server auto-generates a secure password and prints it
# in the console on first startup. You can then log in and change it from
# Settings → Account in the admin panel.
ADMIN_EMAIL=admin@osr.bulsu.edu.ph
ADMIN_PASSWORD=

# Local data paths. These directories are created automatically.
DB_PATH=./db/local-osr.db
UPLOAD_DIR=./uploads

# Comma-separated browser origins allowed to make credentialed cross-origin API calls.
# Netlify uses same-origin requests. No additional origin is required there.
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000